# כתובת בסיס לפרודקשן — חובה לפני deploy
# לדוגמה: https://smbrows.co.il או https://sm-brows.vercel.app
NEXT_PUBLIC_SITE_URL=https://smbrows.co.il

# יומן גוגל (קיים כבר ב-.env.local)
#
# שתי צורות נתמכות למפתח חשבון השירות, ו-lib/googleCalendar.ts בודק אותן
# בסדר הזה: קודם BASE64, ורק אם הוא חסר — הצורה הגולמית. די באחת מהן.
#
# ✅ GOOGLE_SERVICE_ACCOUNT_KEY_BASE64 — **הצורה המועדפת ב-Vercel.** ה-JSON
#    הגולמי מכיל \n בתוך ה-private key, ו-Vercel נכשל בפרסור שלו (ראה commit
#    248c881). קידוד base64 של קובץ ה-JSON כולו פותר זאת.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# הצורה הגולמית — עדיין נתמכת בקוד (fallback), נוחה לפיתוח מקומי.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_CALENDAR_ID=name@gmail.com

# ─── שלב 6 — Google Analytics / Meta Pixel ──────────────────────────────────
# שני המשתנים ציבוריים (NEXT_PUBLIC_) — אלה מזהים גלויים ממילא בקוד המקור
# של כל דף, לא סודות. אין hardcode בקוד: אם משתנה חסר, ה-tracker המתאים
# פשוט לא נטען, בלי קריסה. שני הספקים גם ככה נטענים רק אחרי הסכמה מפורשת
# של המבקרת (ראה lib/consentContext.tsx) — הגדרת המשתנה לבדה לא מדליקה כלום.
#
# NEXT_PUBLIC_GA_ID       — מזהה מדידה של GA4, בפורמט G-XXXXXXXXXX.
# NEXT_PUBLIC_META_PIXEL_ID — מזהה ה-Pixel של Meta (מספרי).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=


# ─── אזור אישי ללקוחות ──────────────────────────────────────────────────────
# נדרש משלב 2 ואילך. עד שהמשתנים האלה מוגדרים, האזור האישי כבוי
# והאתר ממשיך לעבוד בדיוק כמו היום (זרימת הוואטסאפ).

# Supabase — מתוך Project Settings › API בלוח הבקרה
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ מפתח מנהלתי — עוקף את כל הרשאות ה-RLS.
# רק בשרת. לעולם לא בקוד, לא בקומיט ולא במשתנה שמתחיל ב-NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# סוד לגיבוב קודי האימות. מחרוזת אקראית ארוכה, ייחודית לסביבה.
#
# ⚠️ **חובה בכל סביבה.** משלב 12B, ערך חסר או ריק גורם לכשל בטוח של מסלול
# ה-OTP במקום להיבלע בשקט. בפרודקשן נדרשים גם לפחות 32 תווים.
#
# הקוד הקודם כתב `process.env.OTP_PEPPER ?? ''`, כלומר משתנה חסר הוריד את
# הגיבוב ל-sha256(phone:code) — טבלת קשת של מיליון ערכים, בלי אזהרה אחת.
#
# ליצירה:  openssl rand -hex 32
OTP_PEPPER=

# סוד לחתימת ה-session של הלקוחה. שונה מ-OTP_PEPPER, לפחות 32 תווים.
# החלפתו מנתקת את כל הלקוחות המחוברות — וזו הדרך לנתק את כולן בבת אחת.
# ליצירה:  openssl rand -hex 32
SESSION_SECRET=

# ─── SMS — קודי כניסה (OTP) ─────────────────────────────────────────────────
#
# ⚠️ המשתנה הזה שולט על **קודי הכניסה בלבד**. התזכורות נשלטות ע"י
# REMINDER_PROVIDER, והשניים בלתי תלויים לחלוטין: SMS_PROVIDER=sms_019
# אינו מדליק תזכורות, ו-REMINDER_PROVIDER=sms_019 אינו מדליק OTP.
#
#   console = מצב פיתוח, הקוד מודפס ללוג השרת ולא נשלח SMS (ברירת מחדל).
#             🔴 **חסום בפרודקשן.**
#   sms_019 = 🔴 שליחה אמיתית דרך 019. משתמש באותם credentials של שלב 12A.
#   twilio  = מימוש קיים שמעולם לא נבדק מול חשבון אמיתי.
#
# 🔒 **אין נפילה לקונסול.** משלב 12B, כל ערך לא מוכר, credentials חסרים, או
# console בפרודקשן — מחזירים ספק שנכשל בבטחה: לא נשלח דבר, ו**גוף ההודעה
# אינו מודפס בשום מקום**. הקוד הקודם נפל ל-console בכל מצב לא צפוי, כלומר
# טעות הקלדה אחת ב-SMS_PROVIDER הדפיסה קודי כניסה ללוג.
#
# 🔒 בפרודקשן, kind='otp' **לעולם** אינו מודפס לקונסול — גם לא עם
# SMS_ALLOW_CONSOLE_IN_PROD=true. אין דגל שמבטל את זה.
SMS_PROVIDER=console

# 🔴 **להשאיר false בפרודקשן. אינו מיועד לשימוש רגיל.**
# דגל חילוץ צר בלבד: מתיר ל-ConsoleSmsProvider לפעול כש-NODE_ENV=production,
# כלומר להדפיס גוף הודעה ללוגי הפלטפורמה במקום לשלוח SMS. נועד להרצה חיה
# זמנית בלי ספק SMS מוגדר — לא למצב תפעולי קבוע.
# 🔒 אינו חל על kind='otp': קודי כניסה לעולם אינם מודפסים בפרודקשן, גם לא
# עם דגל זה (ראה lib/sms/consoleProvider.ts). אין דגל שמבטל זאת.
SMS_ALLOW_CONSOLE_IN_PROD=false

# נדרש רק כאשר SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# מספר בעלת העסק לקבלת עדכונים על קביעה/הזזה/ביטול, בפורמט E.164.
#
# ⚠️ הערך כאן הוא placeholder בלבד. הערך האמיתי מוגדר ב-.env.local, שאינו
# בקומיט. קובץ תבנית אינו המקום לערך אמיתי — גם כשהוא אינו סוד.
ADMIN_PHONE_E164=+972500000000

# ─── דגל: מערכת קביעת התורים החדשה ──────────────────────────────────────────
# true = הטופס מאפשר OTP ושמירת בקשה כ-pending ב-Supabase (בנוסף לאפשרות
#        "בלי להתחבר" שממשיכה לפתוח וואטסאפ בלבד).
# false / לא מוגדר (ברירת מחדל) = האתר מתנהג בדיוק כמו לפני שלבים 1–3 —
#        הטופס פותח וואטסאפ בלבד, בלי OTP ובלי שמירה ב-DB. גם ה-API של
#        יצירת appointment בודק את הדגל בעצמו (403 אם כבוי), כך שאי אפשר
#        לעקוף אותו דרך קריאת API ישירה.
# בפרודקשן יש להשאיר כבוי עד שהמערכת נבדקה שם.
NEW_BOOKING_SYSTEM_ENABLED=false

# ─── סנכרון נכנס מ-Google Calendar (שלב 8) ─────────────────────────────────
# סוד ל-route הפנימי POST /api/internal/calendar-sync, שנועד להרצה מתוזמנת
# בעתיד. נפרד לגמרי מ-session הניהול: דליפתו אינה נותנת גישה לאזור הניהול,
# וחסימת מנהלת אינה משפיעה עליו.
#
# לא מוגדר, או קצר מ-32 תווים = ה-route מחזיר 404 ופשוט אינו קיים. זו
# ברירת המחדל הרצויה בכל סביבה שבה אין תזמון.
#
# ⚠️ ההפעלה הידנית מתוך מערכת הניהול אינה זקוקה לסוד הזה — היא מוגנת
# ב-session של מנהלת + is_admin + הדגל למעלה.
#
# ליצירה:  openssl rand -base64 48
CALENDAR_SYNC_SECRET=

# ─── תזכורות לתורים (שלב 11) ───────────────────────────────────────────────
# true = ה-worker רשאי לעבד תזכורות ולשלוח אותן דרך הספק שהוגדר.
# false / לא מוגדר (ברירת מחדל) = אין claim, אין ניסיון, ואף תזכורת אינה
#        משנה סטטוס. שורות התזכורת ממשיכות להיווצר ע"י ה-DB, כדי שההיסטוריה
#        תהיה שלמה ושההדלקה תהיה מיידית.
REMINDERS_ENABLED=false

# ספק שליחת התזכורות.
#   disabled  = ברירת המחדל בכל סביבה, כולל production. לא נשלח דבר, ואף
#               תזכורת אינה נתפסת לעיבוד.
#   simulated = סימולציה בפיתוח בלבד. מדפיס שורת לוג עם מזהים בלבד (בלי
#               טלפון, בלי שם ובלי גוף הודעה) ומסמן את התזכורת 'simulated'.
#   sms_019   = 🔴 **שולח SMS אמיתי דרך 019.** ראה הסעיף הבא.
#
# ⚠️ simulated **חסום בפרודקשן** ואין דגל שמאפשר לעקוף זאת. אי אפשר לסמן
# הודעה כ-SMS אמיתי שנשלח כשהספק אינו אמיתי (נאכף כ-CHECK בבסיס הנתונים,
# לא רק בקוד).
#
# ⚠️ שם הספק הוא sms_019 ולא 019: ה-CHECK על העמודה provider דורש אות
# ראשונה (^[a-z][a-z0-9_]{1,31}$), ולכן 019 אינו ערך חוקי.
# אין לשנות את ה-CHECK כדי לאפשר שם שמתחיל בספרה.
REMINDER_PROVIDER=disabled

# ─── התראות לבעלת העסק (שלב 15F) ───────────────────────────────────────────
# true = התראות על בקשת תור חדשה/הזזה/ביטול נשלחות בפועל.
# false / לא מוגדר (ברירת מחדל) = אין שליחה. שורות ההתראה עדיין נוצרות
#        ב-DB כדי שההיסטוריה תהיה שלמה וההדלקה תהיה מיידית — אותו דפוס
#        בדיוק כמו REMINDERS_ENABLED למעלה.
#
# ⚠️ נפרד לגמרי מ-REMINDERS_ENABLED: תזכורות ללקוחה והתראות לבעלת העסק הם
# שני מסלולים עצמאיים, וכל אחד נדלק בנפרד (ראה lib/featureFlags.ts).
NOTIFICATIONS_ENABLED=false

# סוד ל-route הפנימי POST /api/internal/reminders, שנועד להרצה מתוזמנת
# בעתיד. נפרד לגמרי מ-session הניהול ומ-CALENDAR_SYNC_SECRET.
#
# נשלח אך ורק ככותרת:   Authorization: Bearer <REMINDERS_DISPATCH_SECRET>
# לא ב-query string (שם היה נכתב ללוגי הגישה של השרת) ולא בכותרת אחרת.
#
# קודי התגובה:
#   404 = המשתנה לא מוגדר או קצר מ-32 תווים. ה-route אינו קיים בסביבה כזו.
#   401 = כשל אימות בלבד (אין Authorization, scheme אחר, או secret שגוי).
#   200 = הבקשה אומתה — **כולל** כשהמערכת כבויה או שאין ספק. מצב כבוי הוא
#         מצב תפעולי תקין ולא כשל, והתשובה מחזירה enabled:false וספירות אפס.
#
# ⚠️ שלב 11 אינו מפעיל Vercel Cron ואינו יוצר vercel.json.
#
# ליצירה:  openssl rand -base64 48
REMINDERS_DISPATCH_SECRET=

# סוד ל-route הפנימי POST /api/internal/privacy-retention (שלב 9B — מדיניות
# שמירה וניקוי). נפרד לגמרי מ-REMINDERS_DISPATCH_SECRET ומ-CALENDAR_SYNC_SECRET.
#
# נשלח אך ורק ככותרת:   Authorization: Bearer <PRIVACY_RETENTION_SECRET>
# לא ב-query string ולא בכותרת אחרת.
#
# ברירת המחדל של ה-route היא dry-run (ספירות בלבד, ללא כתיבה). ביצוע בפועל
# (mode:"execute") דורש גם body.confirm==="APPLY_RETENTION_V1" — אין הרצה
# בטעות ע"י קריאה עם body ריק/דיפולטי.
#
# ⚠️ שלב 9B אינו מפעיל Vercel Cron ואינו יוצר vercel.json, ואינו מחובר
# ל-QStash. ה-route קיים כדי שהתזמון בעתיד יהיה שינוי הגדרה ולא שינוי קוד —
# ראה docs/data-retention-policy.md.
#
# ליצירה:  openssl rand -base64 48
PRIVACY_RETENTION_SECRET=

# ─── ספק 019 (שלבים 12A ו-12B) ─────────────────────────────────────────────
#
# 🔴 פעיל כאשר REMINDER_PROVIDER=sms_019 (תזכורות) ו/או SMS_PROVIDER=sms_019
# (קודי כניסה). זה הספק היחיד ששולח SMS אמיתי, והיחיד שעבורו status='sent'
# אפשרי בכלל.
#
# ⚠️ ארבעת המשתנים שלמטה **משותפים לשני המסלולים** — זהו אותו חשבון 019 ואותו
# token. הבחירה איזה מסלול פעיל נעשית בשני המשתנים הנפרדים למעלה, לא כאן.
# הגדרתם אינה מדליקה דבר בפני עצמה.
#
# ⚠️ **אין משתנה כתובת.** שתי הכתובות הן קבועים בקוד:
#     https://019sms.co.il/api       — הספק ב-runtime בלבד
#     https://019sms.co.il/api/test  — scripts/probe-019.mjs בלבד (dry-run)
#   אין דרך להפעיל את הספק האמיתי מול כתובת ה-test ואין דרך לגרום ל-probe
#   לשלוח באמת. כתובת חופשית מה-env הייתה אומרת שה-token נשלח לכל יעד ששורה
#   כאן תצביע עליו, ושטעות הקלדה אחת הופכת dry-run לשליחה אמיתית.
#
# ⚠️ אם אחד מהמשתנים חסר או פסול — הספק **נופל ל-disabled** ולא מנסה לשלוח
# על תצורה חלקית. הלוג מציין שמות משתנים בלבד, לעולם לא ערכים.

# שם המשתמש בחשבון 019 (נדרש גם בגוף הבקשה, בנוסף ל-token).
SMS019_USERNAME=

# ⚠️ ה-token נוצר בממשק הווב של 019 (Settings › API Token Management) ומוצג
# **פעם אחת בלבד** — לא ניתן לשחזר אותו אחר כך. תוקפו קבוע ואינו מתחדש.
# יצירת token מ-username+password אינה נתמכת יותר.
#
# 🔒 רק ב-.env.local. לא בקומיט, לא בלוג, לא ב-.handoff, לא בצ'אט.
SMS019_TOKEN=

# שם השולח. עד 11 תווים.
#
# ⚠️ התיעוד כותב "אותיות אנגליות וספרות בלבד", אך שם השולח המאושר בפועל
# מכיל רווח. הוולידציה מתירה רווח **פנימי** בהתאם. רווח בתחילת או בסוף
# הערך נגזם (trim) ואינו נשלח.
#
# ⚠️ הערך חייב להיות תו-בתו כפי שרשום בחשבון 019. שגיאה 515 "Unverified
# source" היא הדחייה שמתקבלת כשהוא אינו תואם — ואי אפשר לנחש אותה נכון.
# מריצים  npm run probe:019  ומאמתים מול /api/test לפני כל שליחה אמיתית.
#
# ⚠️ verify_phone בתיעוד מכסה **מספרי טלפון** כשולח בלבד. רישום שם
# אלפאנומרי נעשה מול תמיכת 019.
SMS019_SOURCE=SM BROWS

# timeout לבקשה, במילישניות. 1000–30000, ברירת מחדל 10000.
#
# ⚠️ timeout **אינו** מעיד שההודעה לא נשלחה. כל חריגה אחרי שהחיבור עמד
# מסווגת delivery_unknown ואינה נכנסת ל-retry אוטומטי — ל-019 אין
# idempotency מוכחת, ולכן retry על תוצאה עמומה הוא SMS שני ללקוחה.
SMS019_TIMEOUT_MS=10000
