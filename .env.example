# כתובת בסיס לפרודקשן — חובה לפני deploy
# לדוגמה: https://smbrows.co.il או https://sm-brows.vercel.app
NEXT_PUBLIC_SITE_URL=https://smbrows.co.il

# יומן גוגל (קיים כבר ב-.env.local)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_CALENDAR_ID=name@gmail.com


# ─── אזור אישי ללקוחות ──────────────────────────────────────────────────────
# נדרש משלב 2 ואילך. עד שהמשתנים האלה מוגדרים, האזור האישי כבוי
# והאתר ממשיך לעבוד בדיוק כמו היום (זרימת הוואטסאפ).

# Supabase — מתוך Project Settings › API בלוח הבקרה
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ מפתח מנהלתי — עוקף את כל הרשאות ה-RLS.
# רק בשרת. לעולם לא בקוד, לא בקומיט ולא במשתנה שמתחיל ב-NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# סוד לגיבוב קודי האימות. מחרוזת אקראית ארוכה, ייחודית לסביבה.
# ליצירה:  openssl rand -hex 32
OTP_PEPPER=

# סוד לחתימת ה-session של הלקוחה. שונה מ-OTP_PEPPER, לפחות 32 תווים.
# החלפתו מנתקת את כל הלקוחות המחוברות — וזו הדרך לנתק את כולן בבת אחת.
# ליצירה:  openssl rand -hex 32
SESSION_SECRET=

# ─── SMS ────────────────────────────────────────────────────────────────────
# console = מצב פיתוח, הקוד מודפס ללוג השרת ולא נשלח SMS (ברירת מחדל).
# twilio  = שליחה אמיתית.
SMS_PROVIDER=console

# נדרש רק כאשר SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# מספר בעלת העסק לקבלת עדכונים על קביעה/הזזה/ביטול, בפורמט E.164
ADMIN_PHONE_E164=+972552932813

# ─── דגל: מערכת קביעת התורים החדשה ──────────────────────────────────────────
# true = הטופס מאפשר OTP ושמירת בקשה כ-pending ב-Supabase (בנוסף לאפשרות
#        "בלי להתחבר" שממשיכה לפתוח וואטסאפ בלבד).
# false / לא מוגדר (ברירת מחדל) = האתר מתנהג בדיוק כמו לפני שלבים 1–3 —
#        הטופס פותח וואטסאפ בלבד, בלי OTP ובלי שמירה ב-DB. גם ה-API של
#        יצירת appointment בודק את הדגל בעצמו (403 אם כבוי), כך שאי אפשר
#        לעקוף אותו דרך קריאת API ישירה.
# בפרודקשן יש להשאיר כבוי עד שהמערכת נבדקה שם.
NEW_BOOKING_SYSTEM_ENABLED=false

# ─── סנכרון נכנס מ-Google Calendar (שלב 8) ─────────────────────────────────
# סוד ל-route הפנימי POST /api/internal/calendar-sync, שנועד להרצה מתוזמנת
# בעתיד. נפרד לגמרי מ-session הניהול: דליפתו אינה נותנת גישה לאזור הניהול,
# וחסימת מנהלת אינה משפיעה עליו.
#
# לא מוגדר, או קצר מ-32 תווים = ה-route מחזיר 404 ופשוט אינו קיים. זו
# ברירת המחדל הרצויה בכל סביבה שבה אין תזמון.
#
# ⚠️ ההפעלה הידנית מתוך מערכת הניהול אינה זקוקה לסוד הזה — היא מוגנת
# ב-session של מנהלת + is_admin + הדגל למעלה.
#
# ליצירה:  openssl rand -base64 48
CALENDAR_SYNC_SECRET=
