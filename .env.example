# כתובת בסיס לפרודקשן — חובה לפני deploy
# לדוגמה: https://smbrows.co.il או https://sm-brows.vercel.app
NEXT_PUBLIC_SITE_URL=https://smbrows.co.il

# יומן גוגל (קיים כבר ב-.env.local)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_CALENDAR_ID=name@gmail.com


# ─── אזור אישי ללקוחות ──────────────────────────────────────────────────────
# נדרש משלב 2 ואילך. עד שהמשתנים האלה מוגדרים, האזור האישי כבוי
# והאתר ממשיך לעבוד בדיוק כמו היום (זרימת הוואטסאפ).

# Supabase — מתוך Project Settings › API בלוח הבקרה
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ מפתח מנהלתי — עוקף את כל הרשאות ה-RLS.
# רק בשרת. לעולם לא בקוד, לא בקומיט ולא במשתנה שמתחיל ב-NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# סוד לגיבוב קודי האימות. מחרוזת אקראית ארוכה, ייחודית לסביבה.
# ליצירה:  openssl rand -hex 32
OTP_PEPPER=

# סוד לחתימת ה-session של הלקוחה. שונה מ-OTP_PEPPER, לפחות 32 תווים.
# החלפתו מנתקת את כל הלקוחות המחוברות — וזו הדרך לנתק את כולן בבת אחת.
# ליצירה:  openssl rand -hex 32
SESSION_SECRET=

# ─── SMS ────────────────────────────────────────────────────────────────────
# console = מצב פיתוח, הקוד מודפס ללוג השרת ולא נשלח SMS (ברירת מחדל).
# twilio  = שליחה אמיתית.
SMS_PROVIDER=console

# נדרש רק כאשר SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# מספר בעלת העסק לקבלת עדכונים על קביעה/הזזה/ביטול, בפורמט E.164
ADMIN_PHONE_E164=+972552932813
